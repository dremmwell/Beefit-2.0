generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id            String @id
  username      String @unique
  password_hash String
  avatar        Int    @default(1)

  createdAt DateTime @default(now())

  sessions    Session[]
  ingredients Ingredient[]
  recipes     Recipe[]
  meal        Meal[]
  objectives  Objective[]

  archivedMeal   ArchivedMeal[]
  archivedRecipe ArchivedRecipe[]
  labels         Labels[]
  foci           Focus[]
  exercices      Exercice[]
  exerciceGroups ExerciceGroup[]
  splits         Split[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model Ingredient {
  id            String @id @unique @default(uuid())
  name          String
  unit          String
  gramsPerUnit  Float
  calories      Int
  proteins      Float
  carbs         Float
  fats          Float
  saturatedFats Float  @default(0)
  fibers        Float  @default(0)
  userId        String

  bookmarked Boolean @default(false)
  customMeal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  recipeIngredient RecipeIngredient[]
  MealIngredient   MealIngredient[]

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model Recipe {
  id           String  @id @default(uuid())
  name         String  @unique
  bookmarked   Boolean @default(false)
  instructions String
  isOriginal   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  ingredients RecipeIngredient[]
  meal        MealRecipe[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model RecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Float  @default(100)
  unit         String @default("grams")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model MealIngredient {
  id           String @id @default(uuid())
  ingredientId String
  mealId       String
  quantity     Float
  unit         String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  meal       Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model MealRecipe {
  id       String @id @default(uuid())
  recipeId String
  mealId   String
  quantity Float
  unit     String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model Meal {
  id       String @id @default(uuid())
  mealType String

  ingredients MealIngredient[]
  recipe      MealRecipe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Objective {
  id       String @id @default(uuid())
  calories Float  @default(1600)
  proteins Float  @default(120)
  carbs    Float  @default(300)
  fats     Float  @default(80)

  createdAt DateTime @default(now())

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

//--------------- Archived Data Models ----------------//

model ArchivedMeal {
  id          String @id @default(uuid())
  description String
  mealType    String

  calories      Float
  proteins      Float
  carbs         Float
  fats          Float
  saturatedFats Float @default(0)
  fibers        Float @default(0)

  createdAt DateTime @default(now())

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model ArchivedRecipe {
  id            String @id @default(uuid())
  name          String
  instructions  String
  calories      Float
  proteins      Float
  carbs         Float
  fats          Float
  saturatedFats Float  @default(0)
  fibers        Float  @default(0)

  createdAt DateTime @default(now())

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

//--------------- Workouts ----------------//

model Labels {
  id    String @id @default(uuid())
  name  String
  color String

  createdAt DateTime @default(now())

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  focusId String
  Focus   Focus  @relation(fields: [focusId], references: [id], onDelete: Cascade)

  execiceLabels ExeciceLabels[]
}

model Focus {
  id       String @id @default(uuid())
  name     String
  priority String

  createdAt DateTime @default(now())

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  labels Labels[]
}

model Exercice {
  id          String @id @default(uuid())
  name        String
  description String

  createdAt DateTime @default(now())

  groupOrder Int @default(0)

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  perfs           ExercicePerfs[]
  execiceLabels   ExeciceLabels[]
  exerciceGroup   ExerciceGroup?  @relation(fields: [exerciceGroupId], references: [id])
  exerciceGroupId String?
}

model ExercicePerfs {
  id      String @id @default(uuid())
  weights Float
  unit    String
  sets    Int    @default(1)
  reps    Int
  notes   String

  createdAt DateTime @default(now())

  exerciceId String
  Exercice   Exercice @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
}

model ExeciceLabels {
  id         String @id @default(uuid())
  labelId    String
  exerciceId String
  value      String

  createdAt DateTime @default(now())

  Labels   Labels   @relation(fields: [labelId], references: [id], onDelete: Cascade)
  Exercice Exercice @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
}

model ExerciceGroup {
  id    String @id @default(uuid())
  name  String
  order Int

  createdAt DateTime @default(now())

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exercices Exercice[]
}

model Split {
  id        String   @id @default(uuid())
  startDate DateTime @default(now())
  length    Int      @default(7)

  createdAt DateTime @default(now())

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
